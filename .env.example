# ==========================================
# Cyberpump Monorepo Environment Variables
# ==========================================

# --- Backend Configuration ---
# MongoDB connection string (inside docker network use 'mongo:27017')
MONGO_URI=mongodb://mongo:27017/cyberpump

# JWT secret key for signing auth tokens (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_32_chars_min

# Token lifetimes in seconds (Access: 10 mins, Refresh: 7 days)
ACCESS_TTL_S=600
REFRESH_TTL_S=604800

# Shared secret token for telemetry ingestion
TELEMETRY_SERVICE_TOKEN=replace_with_a_secure_telemetry_shared_secret

# Retention period in days for raw telemetry samples
TELEMETRY_RETENTION_DAYS=90

# --- Frontend Configuration ---
PUBLIC_APP_TITLE=Cyberpump
BACKEND_API_URL=http://backend:9000

# SvelteKit public origin used for CSRF protection in production.
# Set this to the exact browser-visible origin (scheme + host + optional port),
# e.g. https://staging.example.com or https://your-service-abc-uc.a.run.app.
# Keep localhost only for local development.
ORIGIN=http://localhost:3000

